# ---------------------------------------------------------------------------
# Profit Harvester - instellingen
#
# Kopieer dit bestand naar .env en vul je eigen waarden in:
#     cp .env.example .env
# Deel je .env NOOIT met anderen en zet hem nooit op GitHub.
# ---------------------------------------------------------------------------

# --- Demo-modus ------------------------------------------------------------
# 1 = oefenen zonder echt geld: echte koersen van Bitvavo, maar een nep-saldo
#     en gesimuleerde orders. Er is dan GEEN Bitvavo-API-key nodig.
#     Demo-gegevens staan in aparte bestanden (demo_*.json), los van echt.
# 0 = echt handelen met je Bitvavo-account.
DEMO_MODUS=1
# Nep-startkapitaal in euro's voor de demo.
DEMO_STARTKAPITAAL=1000

# --- Bitvavo (verplicht als DEMO_MODUS=0) ----------------------------------
# Maak een API-key aan in je Bitvavo-account onder Instellingen > API.
# Geef alleen de rechten "Bekijken" en "Handelen". Zet "Opnemen" NOOIT aan.
BITVAVO_API_KEY=
BITVAVO_API_SECRET=
# Operator-ID dat Bitvavo bij elke order meestuurt: een zelfgekozen getal
# waarmee je orders van deze bot herkent. Laat de regel uitgecommentarieerd
# (met # ervoor) om de standaardwaarde te gebruiken; een lege waarde werkt niet.
# BITVAVO_OPERATOR_ID=1234567890

# --- Dashboard (verplicht) -------------------------------------------------
# Wachtwoord voor het webdashboard. Gebruik een lange, willekeurige reeks,
# bijvoorbeeld de uitkomst van:  python -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_TOKEN=
# Poort van het dashboard (standaard 5000).
DASHBOARD_PORT=5000
# 1 = inloggen werkt alleen via https (veiligst, bijv. via Tailscale Funnel).
# 0 = ook via gewone http, nodig als je het dashboard op je thuisnetwerk
#     opent via http://<ip-van-je-pi>:5000
DASHBOARD_ALLEEN_HTTPS=1
# 1 = het dashboard draait achter een proxy (Tailscale Funnel, nginx, Caddy).
#     Alleen dan wordt het IP-adres uit de proxy-header gebruikt voor de
#     blokkade na 5 mislukte inlogpogingen. Anders op 0 laten.
VERTROUW_PROXY=0

# --- Telegram (aanbevolen) -------------------------------------------------
# Maak een bot via @BotFather in Telegram en vul het token in.
# Je chat-ID vind je bijvoorbeeld via @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Dagelijks e-mailrapport (optioneel) -----------------------------------
# Standaard via Gmail. Gebruik dan een app-wachtwoord, niet je gewone
# wachtwoord (Google-account > Beveiliging > App-wachtwoorden).
EMAIL_SENDER=
EMAIL_PASSWORD=
EMAIL_RECEIVER=
# Andere mailprovider? Vul dan de SMTP-server en poort (STARTTLS) in,
# bijvoorbeeld smtp.office365.com / 587. Leeg laten = Gmail.
# EMAIL_SMTP_SERVER=smtp.gmail.com
# EMAIL_SMTP_POORT=587
